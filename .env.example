# SENTRIX-PT — Environment Configuration
# Copy to .env and fill in your values

# Target LLM API (the model you want to test)
TARGET_API_URL=https://api.openai.com/v1/chat/completions
TARGET_API_KEY=your_target_api_key_here
TARGET_MODEL=gpt-4o

# VIPER Analysis (Groq)
GROQ_API_KEY=your_groq_api_key_here
VIPER_MODEL=qwen-qwq-32b

# Output
REPORT_OUTPUT_DIR=./reports
LOG_LEVEL=INFO
